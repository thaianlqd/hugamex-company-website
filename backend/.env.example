SPRING_PROFILES_ACTIVE=dev
DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/hugamex
DATABASE_USERNAME=
DATABASE_PASSWORD=
JWT_SIGNING_KEY=
TOKEN_HASH_KEY=
OTP_HMAC_KEY=
MFA_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5180,http://localhost:5180
FRONTEND_URL=http://127.0.0.1:5173
# file: dev/test only; smtp: dev or prod, requires every SMTP field below.
MAIL_MODE=file
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
# Use a Google App Password for Gmail, never your regular account password.
SMTP_PASSWORD=
# Gmail: use the same address as SMTP_USERNAME.
MAIL_FROM=

# Reviewed development preview only; keep false for normal startup.
ALLOW_SUPABASE_PREVIEW_SEED=false
RUN_SUPABASE_PREVIEW_SEED_JOB=false

# Contact enquiries are also saved in the CMS inbox; no real mail in default file mode.
CONTACT_NOTIFICATIONS_ENABLED=false
CONTACT_NOTIFICATION_EMAIL=
