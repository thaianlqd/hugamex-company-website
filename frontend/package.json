{
  "name": "hugamex-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --mode public",
    "dev:admin": "vite --host 127.0.0.1 --mode admin",
    "build": "tsc -b && vite build",
    "build:admin": "tsc -b && vite build --mode admin --outDir dist-admin",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "format": "prettier --write src",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "prebuild": "node scripts/robots.mjs"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.2.5",
    "@hookform/resolvers": "^5.1.0",
    "@tailwindcss/vite": "^4.1.0",
    "@tanstack/react-query": "^5.80.0",
    "@tiptap/react": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "axios": "^1.10.0",
    "framer-motion": "^12.16.0",
    "i18next": "^25.2.0",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.57.0",
    "react-i18next": "^15.5.0",
    "react-router-dom": "^7.6.0",
    "tailwindcss": "^4.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.28.0",
    "@playwright/test": "^1.52.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "jsdom": "^26.1.0",
    "prettier": "^3.5.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.33.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.11"
  }
}
